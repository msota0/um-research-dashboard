# ─── Copy to .env and fill in. NEVER commit .env. ───────────────────────────

# Postgres connection (SQLAlchemy URL).
# Local dev (Postgres.app):   postgresql+psycopg://maheksota@localhost:5432/um_dashboard
# On-prem server:             postgresql+psycopg://USER:PASSWORD@HOST:5432/um_dashboard
DATABASE_URL=postgresql+psycopg://maheksota@localhost:5432/um_dashboard

# OpenAlex polite-pool email (higher rate limit). Use a real address.
OPENALEX_EMAIL=you@olemiss.edu

# Dimensions Analytics (DSL) API key. ROTATE the old leaked key before use.
DIMENSIONS_API_KEY=PUT_YOUR_DIMENSIONS_KEY_HERE

# Institution identity (Oxford campus only — NOT UMMC Jackson).
# Verified against OpenAlex: UM Oxford = I368840534 / ror 02teq1165.
INST_OPENALEX_ID=I368840534
INST_ROR=https://ror.org/02teq1165
INST_EXCLUDE_IDS=I29606459
DIM_GRID=grid.251313.7

# Year window for all data.
YEAR_FROM=2018
YEAR_TO=2026

# Ingestion controls.
#   Leave INGEST_LIMIT_AUTHORS unset/0 on the server for a full backfill.
#   Set to 50 locally so dev runs in minutes, not hours.
INGEST_LIMIT_AUTHORS=50
#   Allow the (fragile, ToS-sensitive) Google Scholar scraping step. Off by default.
ENABLE_SCHOLARLY=false

# CORS origin for the Next.js frontend.
FRONTEND_ORIGIN=http://localhost:3000
