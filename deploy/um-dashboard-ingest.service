# One-shot ingestion run (used by the .timer for nightly refresh, and runnable
# manually for the initial full backfill: `sudo systemctl start um-dashboard-ingest`).
# Leave INGEST_LIMIT_AUTHORS unset/0 in .env on the server for a full run.
[Unit]
Description=UM Research Dashboard ingestion
After=network.target postgresql.service

[Service]
Type=oneshot
User=www-data
WorkingDirectory=/opt/um-research-dashboard
EnvironmentFile=/opt/um-research-dashboard/.env
ExecStart=/opt/um-research-dashboard/.venv/bin/python -m backend.ingest.run incremental
# Backfill can take a while the first time; don't let systemd kill it.
TimeoutStartSec=0
